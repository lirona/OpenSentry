# Copy this file to `.dev.vars` (gitignored) for local `wrangler pages dev`
# runs. In production, set the same keys in the Cloudflare Pages dashboard
# under Settings -> Environment variables (marked as Encrypted / Secret).

# --- AI provider ---
# Supported values: "gemini" (default), "claude", "codex", "codex-cli", or "claude-cli".
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL=""
# Optional local/runtime overrides for slower providers like codex-cli or claude-cli.
AI_TOTAL_BUDGET_MS=""
AI_PER_ATTEMPT_TIMEOUT_MS=""
# --- API abuse protection ---
# Optional model-call concurrency. Defaults to 1 to avoid free-tier burst limits.
AI_AGENT_CONCURRENCY="1"
# Optional per-IP cooldown in milliseconds. Set to 0 to disable.
ANALYZE_IP_COOLDOWN_MS="15000"
# Optional global daily cap. Set to 0 to disable.
ANALYZE_DAILY_CAP="0"

# --- Public-site relay to a local desktop runner ---
# Set ANALYZE_RELAY_URL only in production Cloudflare Pages if /api/analyze
# should forward to a tunnel on your desktop instead of running in Cloudflare.
ANALYZE_RELAY_URL=""
# Set the same token in production and on the local desktop runner. When this
# token is set locally without ANALYZE_RELAY_URL, /api/analyze requires the
# x-opensentry-runner-token header.
ANALYZE_RELAY_TOKEN=""

# --- Etherscan V2 (unified multichain key) ---
# Etherscan V2 uses ONE key across all supported chains
# (Ethereum, Base, Arbitrum, Optimism, Polygon, ...).
ETHERSCAN_API_KEY=""
